# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Адрес AJAX-запроса реестра лицензий Росздравнадзора (можно уточнить в DevTools браузера,
# вкладка Network, на странице https://roszdravnadzor.gov.ru/services/licenses)
RZN_SEARCH_URL=https://roszdravnadzor.gov.ru/ajax/services/licenses
# Имя параметра, в который передаётся ИНН
RZN_INN_PARAM=q_inn
# Сайты на gov.ru часто используют сертификат «Russian Trusted Root CA».
# Укажите путь к PEM-файлу корневого сертификата Минцифры или false, чтобы отключить проверку (не рекомендуется).
RZN_SSL_VERIFY=true
RZN_TIMEOUT=30

# Прокси только для Telegram (если api.telegram.org недоступен напрямую), например:
# TG_PROXY=socks5://127.0.0.1:1080   или   TG_PROXY=http://127.0.0.1:8080
TG_PROXY=
